{
    "name": "acbjtechnology/zend-text-25",
    "description": " ",
    "license": "BSD-3-Clause",
    "keywords": [
        "zf2",
        "text"
    ],
    "homepage": "https://github.com/acbjtechnology/zend-text-25",
    "autoload": {
        "psr-4": {
            "Zend\\Text\\": "src/"
        }
    },
    "require": {
        "php": ">=7.3",
        "acbjtechnology/zend-stdlib-25": "@dev",
        "acbjtechnology/zend-servicemanager-25": "@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": false,
    "extra": {
        "branch-alias": {
            "dev-master": "main",
            "dev-develop": "52-1-1-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZendTest\\Text\\": "test/"
        }
    },
    "require-dev": {
        "zendframework/zend-config": "~2.5"
    },
    "repositories" : [
        {
            "type":"package",
            "package": {
                "name": "acbjtechnology/zend-stdlib-25",
                "version":"dev-main",
                "source": {
                    "url": "https://github.com/acbjtechnology/zend-stdlib-25.git",
                    "type": "git",
                    "reference":"main"
                },
                "autoload": {
                    "psr-4": {
                        "Zend\\Stdlib\\": "src/"
                    }
                }
            }
        },
        {
            "type":"package",
            "package": {
                "name": "acbjtechnology/zend-servicemanager-25",
                "version":"dev-main",
                "source": {
                    "url": "https://github.com/acbjtechnology/zend-servicemanager-25.git",
                    "type": "git",
                    "reference":"main"
                },
                "autoload": {
                    "psr-4": {
                        "Zend\\ServiceManager\\": "src/"
                    }
                }
            }
        }
    ]
}
