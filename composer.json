{
    "name": "acbjtechnology/zend-text-25",
    "description": " ",
    "license": "BSD-3-Clause",
    "keywords": [
        "zf2",
        "text"
    ],
    "homepage": "https://github.com/acbjtechnology/zend-text-25",
    "autoload": {
        "psr-4": {
            "Zend\\Text\\": "src/"
        }
    },
    "require": {
        "php": ">=7.3",
        "zendframework/zend-stdlib": "~2.5",
        "zendframework/zend-servicemanager": "~2.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": false,
    "extra": {
        "branch-alias": {
            "dev-master": "main",
            "dev-develop": "52-1-1-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZendTest\\Text\\": "test/"
        }
    },
    "require-dev": {
        "zendframework/zend-config": "~2.5"
    }
}
